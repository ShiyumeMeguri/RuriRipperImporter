    "Diffuse": {"role": "base_color"},
    "DiffuseMap": {"role": "base_color"},
    "Albedo": {"role": "base_color"},
    "Normal": {"role": "normal"},
    "NormalMap": {"role": "normal"},
    "NormalTexture": {"role": "normal"},
    "Emissive": {"role": "emission"},
    "EmissiveColor": {"role": "emission"},
    "EmissiveMap": {"role": "emission"},
    "Roughness": {"channels": {"roughness": 0}},
    "RoughnessMap": {"channels": {"roughness": 0}},
    "Metallic": {"channels": {"metallic": 0}},
