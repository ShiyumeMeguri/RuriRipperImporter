    "Specular": {"channels": {"specular": 0}},
    "SpecularMap": {"channels": {"specular": 0}},
    "AmbientOcclusion": {"channels": {"occlusion": 0}},
    "AO": {"channels": {"occlusion": 0}},
    "Opacity": {"channels": {"opacity": 0}},
    "OpacityMask": {"channels": {"opacity": 0}},
